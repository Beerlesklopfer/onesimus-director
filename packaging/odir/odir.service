[Unit]
Description=Onesimus Director Daemon
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bareos
Group=bareos
ExecStart=/usr/sbin/odir -c /etc/bareos/bareos-dir.d -f
ExecReload=/bin/kill -HUP $MAINPID
LimitNOFILE=65536
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/bareos

[Install]
WantedBy=multi-user.target
