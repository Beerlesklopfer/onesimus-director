#!/bin/sh
# ofd-plugin-postgresql postinst: on every install and upgrade
#  1. every PostgreSQL cluster of this host lets its owner (the user the
#     broker runs as) log in over the local socket with peer authentication;
#  2. ofd loads the plugin ("Plugin Names = postgresql").
# Nothing here may break the installation: problems are reported, the
# previous state is restored, and the script exits 0.
set -u

MARK="# ofd-plugin-postgresql"
FD_DIR=${OFD_PLUGIN_FD_DIR:-/etc/bareos/bareos-fd.d}

log() { echo "ofd-plugin-postgresql: $*"; }

# --- 1. peer access for the broker, per cluster ---------------------------

# Log in exactly as onesimus-pg-broker does: as the cluster owner, local
# socket, no password.
login_ok() { # ver cluster port owner socketdir
    runuser -u "$4" -- env -i "/usr/lib/postgresql/$1/bin/psql" \
        -h "$5" -p "$3" -d postgres -XAtqw -c 'select 1' >/dev/null 2>&1
}

configure_cluster() { # ver cluster port status owner
    ver=$1 cl=$2 port=$3 status=$4 owner=$5
    if [ "$owner" = root ]; then
        log "$ver/$cl: owner is root, skipped (the broker never runs as root)"
        return
    fi
    if [ "$status" != online ]; then
        log "$ver/$cl: not running, checked again on the next upgrade"
        return
    fi
    sockdir=$(pg_conftool -s "$ver" "$cl" show unix_socket_directories 2>/dev/null | cut -d, -f1 | tr -d " '")
    [ -n "$sockdir" ] || sockdir=/var/run/postgresql
    if login_ok "$ver" "$cl" "$port" "$owner" "$sockdir"; then
        log "$ver/$cl: peer login of $owner works"
        return
    fi
    hba=$(pg_conftool -s "$ver" "$cl" show hba_file 2>/dev/null | tr -d "'")
    [ -n "$hba" ] && [ -f "$hba" ] || hba="/etc/postgresql/$ver/$cl/pg_hba.conf"
    if [ ! -f "$hba" ]; then
        log "$ver/$cl: pg_hba.conf not found, please allow 'local all $owner peer'"
        return
    fi
    backup="$hba.ofd-plugin-postgresql.bak"
    cp -p "$hba" "$backup" || return
    # pg_hba.conf is first-match: the rule goes before the first rule.
    awk -v rule="local   all   $owner   peer   $MARK" '
        !done && $0 !~ /^[[:space:]]*(#|$)/ { print rule; done = 1 }
        { print }
        END { if (!done) print rule }' "$backup" > "$hba.ofd-new" &&
        chown --reference="$backup" "$hba.ofd-new" &&
        chmod --reference="$backup" "$hba.ofd-new" &&
        mv "$hba.ofd-new" "$hba" || { rm -f "$hba.ofd-new"; return; }
    if pg_ctlcluster "$ver" "$cl" reload >/dev/null 2>&1 &&
       login_ok "$ver" "$cl" "$port" "$owner" "$sockdir"; then
        log "$ver/$cl: added 'local all $owner peer' to $hba"
        rm -f "$backup"
    else
        mv "$backup" "$hba"
        pg_ctlcluster "$ver" "$cl" reload >/dev/null 2>&1
        log "$ver/$cl: peer login of $owner still fails; $hba left unchanged, please check"
    fi
}

configure_postgresql() {
    if ! command -v pg_lsclusters >/dev/null 2>&1; then
        log "no PostgreSQL clusters (pg_lsclusters missing)"
        return
    fi
    pg_lsclusters -h 2>/dev/null | while read -r ver cl port status owner _rest; do
        configure_cluster "$ver" "$cl" "$port" "$status" "$owner"
    done
}

# --- 2. ofd: Plugin Names --------------------------------------------------

fd_has_plugin() {
    grep -rihE '^[[:space:]]*Plugin[[:space:]]*Names[[:space:]]*=' "$FD_DIR" 2>/dev/null |
        grep -qiE '(^|[="[:space:],])postgresql([",[:space:]]|$)'
}

configure_ofd() {
    if [ ! -d "$FD_DIR" ]; then
        log "$FD_DIR missing, ofd not configured"
        return
    fi
    if fd_has_plugin; then
        log "ofd already loads postgresql"
        return
    fi
    file=$(grep -rlE '^[[:space:]]*(Client|FileDaemon)[[:space:]]*\{' "$FD_DIR" 2>/dev/null | head -n1)
    if [ -z "$file" ]; then
        log "no Client resource in $FD_DIR, please add 'Plugin Names = \"postgresql\"'"
        return
    fi
    backup="$file.ofd-plugin-postgresql.bak"
    cp -p "$file" "$backup" || return
    awk -v line="  Plugin Names = \"postgresql\"   $MARK" '
        { print }
        !done && $0 ~ /^[[:space:]]*(Client|FileDaemon)[[:space:]]*\{/ { print line; done = 1 }' \
        "$backup" > "$file.ofd-new" &&
        chown --reference="$backup" "$file.ofd-new" &&
        chmod --reference="$backup" "$file.ofd-new" &&
        mv "$file.ofd-new" "$file" || { rm -f "$file.ofd-new"; return; }
    if [ -x /usr/sbin/ofd ] && ! /usr/sbin/ofd -t -c "$FD_DIR" >/dev/null 2>&1; then
        mv "$backup" "$file"
        log "ofd -t failed after adding Plugin Names; $file left unchanged"
        return
    fi
    rm -f "$backup"
    log "added Plugin Names = \"postgresql\" to $file"
    restart_ofd
}

# ofd reads its configuration at start. A restart would abort a running
# job, so only restart when no Director/SD connection is open.
restart_ofd() {
    [ -z "${OFD_PLUGIN_NO_RESTART:-}" ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl is-active --quiet ofd 2>/dev/null || return 0
    port=$(sed -n 's/^[[:space:]]*\(FD\)\{0,1\}[[:space:]]*Port[[:space:]]*=[[:space:]]*\([0-9]*\).*/\2/ip' "$FD_DIR"/client/*.conf 2>/dev/null | head -n1)
    port=${port:-9102}
    if ss -Htn state established "( sport = :$port )" 2>/dev/null | grep -q .; then
        log "ofd has open connections (job running?); run 'systemctl restart ofd' afterwards"
        return 0
    fi
    if deb-systemd-invoke try-restart ofd.service >/dev/null 2>&1; then
        log "ofd restarted"
    else
        log "restarting ofd failed; run 'systemctl restart ofd'"
    fi
}

case "${1:-}" in
    configure)
        configure_postgresql
        configure_ofd
        ;;
esac


exit 0
