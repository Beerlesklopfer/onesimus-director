.PP
\fBSynopsis\fR
.nf
run job=<job> [client=<client>] [fd=<fd>] [fileset=<fileset>] [level=<level>] [storage=<storage>] [sd=<sd>] [where=<where>] [regexwhere=<regexwhere>] [bootstrap=<bootstrap>] [replace=<always|ifnewer|ifolder|never>] [when=<when>] [priority=<priority>] [verifyjob=<verifyjob>] [files=<files>] [catalog=<catalog>] [since=<since>] [cloned[=<cloned>]] [verifylist=<verifylist>] [migrationjob=<migrationjob>] [pool=<pool>] [nextpool=<nextpool>] [backupclient=<backupclient>] [restoreclient=<restoreclient>] [pluginoptions=<pluginoptions>] [spooldata=<yes|no>] [comment=<comment>] [ignoreduplicatecheck=<yes|no>] [accurate=<yes|no>] [jobid=<jobid>[,...]] [backupformat=<backupformat>] [consolidatejob=<consolidatejob>] [schedule=<schedule>] [yes]
.fi
.PP
\fBDescription\fR
