#!/bin/sh
# ofd-plugin-openldap postinst: on every install and upgrade ofd loads the
# plugin ("Plugin Names = openldap"). slapd is never changed: the broker
# reads the instance with slapcat as its own user and needs no ACL, group
# or password. Nothing here may break the installation: problems are
# reported, the previous state is restored, and the script exits 0.
set -u

MARK="# ofd-plugin-openldap"
FD_DIR=${OFD_PLUGIN_FD_DIR:-/etc/bareos/bareos-fd.d}

log() { echo "ofd-plugin-openldap: $*"; }

fd_has_plugin() {
    grep -rihE '^[[:space:]]*Plugin[[:space:]]*Names[[:space:]]*=' "$FD_DIR" 2>/dev/null |
        grep -qiE '(^|[="[:space:],])openldap([",[:space:]]|$)'
}

configure_ofd() {
    if [ ! -d "$FD_DIR" ]; then
        log "$FD_DIR missing, ofd not configured"
        return
    fi
    if fd_has_plugin; then
        log "ofd already loads openldap"
        return
    fi
    file=$(grep -rlE '^[[:space:]]*(Client|FileDaemon)[[:space:]]*\{' "$FD_DIR" 2>/dev/null | head -n1)
    if [ -z "$file" ]; then
        log "no Client resource in $FD_DIR, please add 'Plugin Names = \"openldap\"'"
        return
    fi
    backup="$file.ofd-plugin-openldap.bak"
    cp -p "$file" "$backup" || return
    # ofd merges several "Plugin Names" lines, so this one does not replace
    # the line of another plugin package.
    awk -v line="  Plugin Names = \"openldap\"   $MARK" '
        { print }
        !done && $0 ~ /^[[:space:]]*(Client|FileDaemon)[[:space:]]*\{/ { print line; done = 1 }' \
        "$backup" > "$file.ofd-new" &&
        chown --reference="$backup" "$file.ofd-new" &&
        chmod --reference="$backup" "$file.ofd-new" &&
        mv "$file.ofd-new" "$file" || { rm -f "$file.ofd-new"; return; }
    if [ -x /usr/sbin/ofd ] && ! /usr/sbin/ofd -t -c "$FD_DIR" >/dev/null 2>&1; then
        mv "$backup" "$file"
        log "ofd -t failed after adding Plugin Names; $file left unchanged"
        return
    fi
    rm -f "$backup"
    log "added Plugin Names = \"openldap\" to $file"
    restart_ofd
}

# ofd reads its configuration at start. A restart would abort a running
# job, so only restart when no Director/SD connection is open.
restart_ofd() {
    [ -z "${OFD_PLUGIN_NO_RESTART:-}" ] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl is-active --quiet ofd 2>/dev/null || return 0
    port=$(sed -n 's/^[[:space:]]*\(FD\)\{0,1\}[[:space:]]*Port[[:space:]]*=[[:space:]]*\([0-9]*\).*/\2/ip' "$FD_DIR"/client/*.conf 2>/dev/null | head -n1)
    port=${port:-9102}
    if ss -Htn state established "( sport = :$port )" 2>/dev/null | grep -q .; then
        log "ofd has open connections (job running?); run 'systemctl restart ofd' afterwards"
        return 0
    fi
    if deb-systemd-invoke try-restart ofd.service >/dev/null 2>&1; then
        log "ofd restarted"
    else
        log "restarting ofd failed; run 'systemctl restart ofd'"
    fi
}

check_slapd() {
    if ! pgrep -x slapd >/dev/null 2>&1; then
        log "no slapd is running; the plugin needs a running slapd to find its user"
        return
    fi
    user=$(ps -o user= -C slapd 2>/dev/null | head -n1)
    if [ "$user" = root ]; then
        log "slapd runs as root; start it with -u openldap (the broker never runs as root)"
    fi
}

case "${1:-}" in
    configure)
        configure_ofd
        check_slapd
        ;;
esac

exit 0
