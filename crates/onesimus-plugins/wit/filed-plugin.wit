package onesimus:filed-plugin@1.0.0;

/// Component ABI for the protobuf service onesimus.filed.plugin.v1.
/// Each byte list holds exactly the corresponding protobuf request/response.
/// Method selection is typed by these exports, never by a guest-provided URL.
/// No ambient WASI, filesystem, socket, process, environment or native imports.
/// Cancel/shutdown interrupt the owning store out of band, not through a queued
/// guest call. The shutdown hook is reserved for a later idle cleanup adapter;
/// traps/cancellation always release the store without relying on guest code.
world plugin {
    export initialize: func(request: list<u8>) -> list<u8>;
    export handle-event: func(request: list<u8>) -> list<u8>;
    export next-file: func(request: list<u8>) -> list<u8>;
    export read-file: func(request: list<u8>) -> list<u8>;
    export write-file: func(request: list<u8>) -> list<u8>;
    export close-file: func(request: list<u8>) -> list<u8>;
    export shutdown: func(request: list<u8>) -> list<u8>;
}

/// The PostgreSQL broker (proto/postgresql_broker.proto). Each function takes
/// and returns one encoded message; the host checks every request and links
/// this interface only for plugins granted "postgresql.read".
interface postgresql {
    info: func(request: list<u8>) -> result<list<u8>, string>;
    database-info: func(request: list<u8>) -> result<list<u8>, string>;
    dump-open: func(request: list<u8>) -> result<list<u8>, string>;
    dump-read: func(request: list<u8>) -> result<list<u8>, string>;
    dump-close: func(request: list<u8>) -> result<list<u8>, string>;
}

/// A plugin with the PostgreSQL broker import.
world postgresql-plugin {
    include plugin;
    import postgresql;
}

/// The OpenLDAP broker, reading (proto/openldap_broker.proto): linked only
/// for plugins granted "openldap.read". Configuration files are opened by
/// the id of the info list and read with dump-read.
interface openldap {
    info: func(request: list<u8>) -> result<list<u8>, string>;
    dump-open: func(request: list<u8>) -> result<list<u8>, string>;
    dump-read: func(request: list<u8>) -> result<list<u8>, string>;
    dump-close: func(request: list<u8>) -> result<list<u8>, string>;
    config-file-open: func(request: list<u8>) -> result<list<u8>, string>;
}

/// The OpenLDAP broker, loading into a new restore target the host
/// creates: real only for plugins granted "openldap.write" in an online
/// restore job; elsewhere every call fails.
interface openldap-restore {
    load-open: func(request: list<u8>) -> result<list<u8>, string>;
    load-write: func(request: list<u8>) -> result<list<u8>, string>;
    load-close: func(request: list<u8>) -> result<list<u8>, string>;
}

/// A plugin with the OpenLDAP broker imports.
world openldap-plugin {
    include plugin;
    import openldap;
    import openldap-restore;
}

/// The Podman broker and host (proto/podman_broker.proto,
/// docs/plans/PODMAN-PLUGIN.md): linked only for the plugin id
/// io.onesimus.podman with contract 2 and the grant "podman.inventory".
/// The host computes the allowed object set and filters every answer
/// through a positive list; stop, mask and restart are host-only.
interface podman {
    engine-identify: func(request: list<u8>) -> result<list<u8>, string>;
    inventory: func(request: list<u8>) -> result<list<u8>, string>;
    inspect: func(request: list<u8>) -> result<list<u8>, string>;
    member-state: func(request: list<u8>) -> result<list<u8>, string>;
}

/// Volume data (grant "podman.volume.read"): the host scans and answers with
/// scan references for FileEntry.source_ref, never bytes or attributes.
interface podman-volume {
    volume-scan: func(request: list<u8>) -> result<list<u8>, string>;
}

/// A plugin with the Podman imports.
world podman-plugin {
    include plugin;
    import podman;
    import podman-volume;
}
