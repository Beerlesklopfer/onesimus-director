{"id": "c091-bvfs-restore-twice", "setup": [".bvfs_update jobid=1"], "steps": [".bvfs_restore jobid=1 fileid=1 path=b2parity4", ".bvfs_restore jobid=1 fileid=2 path=b2parity4", ".bvfs_cleanup path=b2parity4", ".bvfs_cleanup path=b2parity4"]}
