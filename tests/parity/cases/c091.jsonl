{"id": "c091-bvfs-restore-noargs", "steps": [".bvfs_restore"]}
{"id": "c091-bvfs-restore-nopath", "steps": [".bvfs_restore jobid=1"]}
{"id": "c091-bvfs-restore-badpath", "steps": [".bvfs_restore jobid=1 path=nosuchpath"]}
{"id": "c091-bvfs-restore-api2", "setup": [".api 2"], "steps": [".bvfs_restore jobid=1 path=nosuchpath"]}
{"id": "c091-bvfs-restore-fileid", "steps": [".bvfs_restore jobid=1 fileid=1 path=b2xxx"]}
