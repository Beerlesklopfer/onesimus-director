{"id": "c058-admin-yes", "isolated": true, "note": "Admin job (no daemon contact): job messages, AdminCleanup report and Job record", "steps": ["run job=parity-admin yes", "wait", "messages", "sqlquery", "select type,level,jobstatus,jobfiles,jobbytes,readbytes,joberrors,poolid,filesetid,clientid,priorjobid,volsessionid,comment from job where name='parity-admin' order by jobid desc limit 1;", ""], "normalize": ["JobId=?\\s*\\d+", "\\d{4}-\\d\\d-\\d\\d_\\d\\d\\.\\d\\d\\.\\d\\d_\\d\\d", "\\d\\d-\\w{3}(-\\d{4})? \\d\\d:\\d\\d(:\\d\\d)?", "Version: [^\\n]*", "BAREOS [^\\n]*", "binary info: [^\\n]*", "JobId:? +\\d+"]}
{"id": "c058-admin-dialog-yes", "isolated": true, "note": "interactive run: level Full (DisplayJobParameters) and the audit info message", "steps": ["run job=parity-admin", "yes", "wait", "messages", "sqlquery", "select type,level,jobstatus,poolid,filesetid,clientid from job where name='parity-admin' order by jobid desc limit 1;", ""], "normalize": ["When: +[0-9: -]+", "JobId=?\\s*\\d+", "\\d{4}-\\d\\d-\\d\\d_\\d\\d\\.\\d\\d\\.\\d\\d_\\d\\d", "\\d\\d-\\w{3}(-\\d{4})? \\d\\d:\\d\\d(:\\d\\d)?", "Version: [^\\n]*", "BAREOS [^\\n]*", "binary info: [^\\n]*", "JobId:? +\\d+"]}
{"id": "c058-admin-api2", "isolated": true, "steps": [".api 2", "run job=parity-admin", "wait", ".api 0", "messages"], "normalize": ["\"jobid\": \"\\d+\"", "JobId=?\\s*\\d+", "\\d{4}-\\d\\d-\\d\\d_\\d\\d\\.\\d\\d\\.\\d\\d_\\d\\d", "\\d\\d-\\w{3}(-\\d{4})? \\d\\d:\\d\\d(:\\d\\d)?", "Version: [^\\n]*", "BAREOS [^\\n]*", "binary info: [^\\n]*", "JobId:? +\\d+"]}
{"id": "c058-admin-level-full-yes", "isolated": true, "steps": ["run job=parity-admin level=Full yes", "wait", "messages", "sqlquery", "select type,level,jobstatus from job where name='parity-admin' order by jobid desc limit 1;", ""], "normalize": ["JobId=?\\s*\\d+", "\\d{4}-\\d\\d-\\d\\d_\\d\\d\\.\\d\\d\\.\\d\\d_\\d\\d", "\\d\\d-\\w{3}(-\\d{4})? \\d\\d:\\d\\d(:\\d\\d)?", "Version: [^\\n]*", "BAREOS [^\\n]*", "binary info: [^\\n]*", "JobId:? +\\d+"]}
{"id": "c058-admin-disabled", "isolated": true, "note": "a disabled job only stops the scheduler; run starts it", "steps": ["disable job=parity-admin", "run job=parity-admin yes", "enable job=parity-admin", "wait", "messages"], "normalize": ["JobId=?\\s*\\d+", "\\d{4}-\\d\\d-\\d\\d_\\d\\d\\.\\d\\d\\.\\d\\d_\\d\\d", "\\d\\d-\\w{3}(-\\d{4})? \\d\\d:\\d\\d(:\\d\\d)?", "Version: [^\\n]*", "BAREOS [^\\n]*", "binary info: [^\\n]*", "JobId:? +\\d+"]}
{"id": "c058-admin-when-cancel", "isolated": true, "note": "sched_wait(): waiting message (pg_sleep lets it arrive), cancel takes effect at the next 30-second look; then AdminCleanup Canceled", "timeout_ms": 45000, "steps": ["run job=parity-admin when=\"2099-01-01 00:00:00\" yes", "sqlquery", "select pg_sleep(1);", "", "messages", "list jobs jobstatus=C", "cancel job=parity-admin", "yes", "wait", "messages", "sqlquery", "select type,level,jobstatus from job where name='parity-admin' order by jobid desc limit 1;", ""], "normalize": ["JobId=?\\s*\\d+", "\\d{4}-\\d\\d-\\d\\d_\\d\\d\\.\\d\\d\\.\\d\\d_\\d\\d", "\\d\\d-\\w{3}(-\\d{4})? \\d\\d:\\d\\d(:\\d\\d)?", "waiting \\d+ seconds", "Version: [^\\n]*", "BAREOS [^\\n]*", "binary info: [^\\n]*", "JobId:? +\\d+", "\\|\\s+\\d+ \\| parity-admin"]}
