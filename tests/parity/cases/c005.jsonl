# C-005 silent toggles: autodisplay/gui/automount argument variants (read-only, session state only).
{"id": "c005-autodisplay-noarg", "steps": ["autodisplay"]}
{"id": "c005-autodisplay-foo", "steps": ["autodisplay foo"]}
{"id": "c005-autodisplay-upper", "steps": ["autodisplay ON"]}
{"id": "c005-autodisplay-later-kw", "steps": ["autodisplay foo off"]}
{"id": "c005-autodisplay-kv", "steps": ["autodisplay on=1"]}
{"id": "c005-autodisplay-off-on", "steps": ["autodisplay off", "autodisplay on"]}
{"id": "c005-autodisplay-foo-api1", "steps": ["autodisplay foo"], "setup": [".api 1"]}
