{"id": "c005-autodisplay-foo-api2", "steps": ["autodisplay foo"], "setup": [".api 2"]}
{"id": "c005-autodisplay-off-api2", "steps": ["autodisplay off"], "setup": [".api 2"]}
{"id": "c005-gui-noarg", "steps": ["gui"]}
{"id": "c005-gui-foo", "steps": ["gui foo"]}
{"id": "c005-gui-upper", "steps": ["gui OFF"]}
{"id": "c005-gui-on-off", "steps": ["gui on", "gui off"]}
{"id": "c005-gui-foo-api2", "steps": ["gui foo"], "setup": [".api 2"]}
