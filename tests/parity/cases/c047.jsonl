# C-047 restore file selection tree (ua_tree.cc), BuildDirectoryTree (ua_restore.cc:1294).
# Every case ends without starting a restore: abort/quit, or done followed by "no".
{"id": "c047-tree-help-abort", "steps": ["restore jobid=1", "help", "?", ".help", "abort"]}
{"id": "c047-tree-ls-cd", "steps": ["restore jobid=1", "ls", "pwd", ".pwd", "cd /etc", "ls", "cd ..", "cd nosuch", "cd a b", "dir", ".dir", ".ls", ".lsdir", "quit"]}
{"id": "c047-tree-mark-count", "steps": ["restore jobid=1", "count", "cd /", "mark etc", "count", "lsmark", ".lsmark", "unmark etc/*", "count", "estimate", "quit"]}
{"id": "c047-tree-find", "steps": ["restore jobid=1", "find", "find *.conf", "find passwd hosts", "quit"]}
{"id": "c047-tree-all", "steps": ["restore jobid=1 all", "count", "estimate", "lsmark", "abort"]}
{"id": "c047-tree-two-jobs", "steps": ["restore jobid=1,5", "count", "find *", "quit"]}
{"id": "c047-tree-invalid", "steps": ["restore jobid=1", "", "bogus", ".bogus", "d", "e", "markdir etc", "unmarkdir etc", "add", "delete", "q"]}
{"id": "c047-tree-api1", "setup": [".api 1"], "steps": ["restore jobid=1", "pwd", "ls", "bogus", "quit"]}
{"id": "c047-tree-mark-files", "steps": ["restore jobid=1,5", "cd /usr/sbin", "mark zic e2*", "ls e*", "lsmark", ".lsmark", "count", "estimate", "cd ..", "lsmark", "ls", "find zic", "unmark e2fsck", "estimate", "cd /", "lsmark", "unmark *", "count", "quit"]}
{"id": "c047-tree-dir-files", "steps": ["restore jobid=5", "cd usr/sbin", "dir", ".dir mk*", "dir nosuch", "cd /usr/sbin/zic", "cd ../../usr", "pwd", "quit"]}
{"id": "c047-tree-mark-paths", "steps": ["restore jobid=1", "mark /usr/sbin/zic", "mark usr/**/e2*", "mark /", "unmark /usr/**", "markdir usr", "cd usr", "markdir sbin", "unmarkdir s*", "lsmark", "add sbin/zic", "delete sbin/", "count", "abort"]}
{"id": "c047-tree-prefix-case", "steps": ["restore jobid=1", "LS", "Co", "es", "fi zic", "h", "m /usr", "un /usr", "dON"], "normalize": ["restore\\.\\d+\\.bsr", "When:.*"]}
