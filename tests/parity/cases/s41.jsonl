{"id": "s41-nextvol-no-schedule", "steps": ["list nextvol job=parity-admin", "list nextvolume job=parity-admin days=7"]}
{"id": "s41-nextvol-fresh-volume", "isolated": true, "restore_reload": true, "config": {"pool/S41.conf": "Pool {\n  Name = S41\n  Pool Type = Backup\n  Recycle = yes\n  AutoPrune = no\n  Volume Retention = 30 days\n}\n", "job/parity-s41.conf": "Job {\n  Name = parity-s41\n  Type = Backup\n  Level = Full\n  Client = bareos-fd\n  FileSet = SelfTest\n  Storage = File\n  Pool = S41\n  Messages = Standard\n  Schedule = ParityPreview\n}\nJob {\n  Name = parity-s41-unscheduled\n  Type = Backup\n  Level = Full\n  Client = bareos-fd\n  FileSet = SelfTest\n  Storage = File\n  Pool = S41\n  Messages = Standard\n}\n"}, "setup": ["reload", "create pool=S41"], "steps": ["list nextvol job=parity-s41", ".sql query=\"INSERT INTO Media (VolumeName,PoolId,MediaType,VolStatus,Enabled,StorageId,LabelDate) SELECT 'S41Fresh',PoolId,'File','Append',1,1,NOW() FROM Pool WHERE Name='S41'\"", "list nextvol job=parity-s41", "list nextvol job=parity-s41-unscheduled", "list nextvol job=parity-s41 days=7", ".sql query=\"DELETE FROM Media WHERE VolumeName='S41Fresh'\""]}
