#!/usr/bin/make -f

# cargo from rustup lives in ~/.cargo/bin, which is not in PATH for every build user
export PATH := $(HOME)/.cargo/bin:$(PATH)

%:
	dh $@

override_dh_auto_build:
	@command -v cargo >/dev/null || { echo "cargo not found: install rustup (https://rustup.rs) or 'apt install cargo rustc'"; exit 1; }
	@test -f proto/director_service.proto || { echo "proto submodule missing: run 'git submodule update --init'"; exit 1; }
	cargo build --release -p onesimus-dird -p oconsole --no-default-features --features oconsole/mcp-production

override_dh_auto_install:
	# === onesimus-dird package ===
	install -D -m 755 target/release/onesimus-dird debian/onesimus-dird/usr/sbin/onesimus-dird
	# Schema (all JSON files from ORM schema dir)
	for f in crates/bareos-orm/schema/*.json; do \
		install -D -m 644 $$f debian/onesimus-dird/usr/lib/bareos/scripts/ddl/$$(basename $$f); \
	done
	# Default configs
	for dir in catalog client console director fileset job jobdefs messages pool profile schedule storage user; do \
		install -d debian/onesimus-dird/usr/share/bareos/defaultconfigs/bareos-dir.d/$$dir; \
	done
	for f in config/bareos-dir.d/*/; do \
		install -m 644 $$f*.conf debian/onesimus-dird/usr/share/bareos/defaultconfigs/bareos-dir.d/$$(basename $$f)/ 2>/dev/null || true; \
	done
	# === oconsole package ===
	install -D -m 755 target/release/oconsole debian/oconsole/usr/bin/oconsole
	install -D -m 644 config/brconsole.conf debian/oconsole/usr/share/bareos/defaultconfigs/oconsole.conf

override_dh_auto_test:
	cargo test --release --no-default-features --features oconsole/mcp-production

override_dh_strip:
	strip debian/onesimus-dird/usr/sbin/onesimus-dird
	strip debian/oconsole/usr/bin/oconsole

override_dh_auto_clean:
	cargo clean 2>/dev/null || true
